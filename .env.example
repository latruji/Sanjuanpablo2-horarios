# --- Google OAuth (Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
NEXTAUTH_URL=https://sanjuanpablo2-horarios.vercel.app
NEXTAUTH_SECRET=   # generar con: openssl rand -base64 32

# --- Vercel Postgres ---
# Si vinculás la base de datos al proyecto desde el dashboard de Vercel
# (Storage -> Connect Project), esta variable se agrega SOLA. No hace
# falta que la cargues a mano.
POSTGRES_URL=

# --- Web Push (VAPID) ---
# generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
